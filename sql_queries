import duckdb

duckdb.query("""
CREATE OR REPLACE TABLE cars AS
SELECT *
FROM df
""")

result = duckdb.query("SELECT * FROM cars LIMIT 5").to_df()
result


brand_price_sql = """
SELECT Brand,
       ROUND(AVG(Price),0) AS avg_price
FROM cars
GROUP BY Brand
ORDER BY avg_price DESC
"""
brand_price = duckdb.query(brand_price_sql).to_df()
print("Average car price by brand")
print(brand_price)



fuel_mileage_sql = """
SELECT Fuel_Type,
       ROUND(AVG(Mileage),2) AS avg_mileage
FROM cars
GROUP BY Fuel_Type
ORDER BY avg_mileage DESC
"""
fuel_mileage = duckdb.query(fuel_mileage_sql).to_df()
print("\n Average mileage by fuel type")
print(fuel_mileage)



cheapest_car_sql = """
SELECT *
FROM (
    SELECT *,
           ROW_NUMBER() OVER(PARTITION BY Brand ORDER BY Price) AS rn
    FROM cars
)
WHERE rn = 1
"""
cheapest_car = duckdb.query(cheapest_car_sql).to_df()
print("\n Most affordable car per brand")
print(cheapest_car)



transmission_count_sql = """
SELECT Transmission,
       COUNT(*) AS num_models
FROM cars
GROUP BY Transmission
"""
transmission_count = duckdb.query(transmission_count_sql).to_df()
print("\n Car count by transmission type")
print(transmission_count)



engine_price_sql = """
SELECT
    CASE
        WHEN Engine_CC < 1200 THEN 'Small Engine'
        WHEN Engine_CC BETWEEN 1200 AND 1800 THEN 'Medium Engine'
        ELSE 'Large Engine'
    END AS engine_category,
    ROUND(AVG(Price),0) AS avg_price
FROM cars
GROUP BY engine_category
ORDER BY avg_price
"""
engine_price = duckdb.query(engine_price_sql).to_df()
print("\n Price vs Engine Category")
print(engine_price)



fuel_efficient_cars_sql = """
SELECT Brand, Model, Price, Mileage
FROM cars
ORDER BY Mileage DESC, Price ASC
LIMIT 10
"""
fuel_efficient_cars = duckdb.query(fuel_efficient_cars_sql).to_df()
print("\n Top 10 most economical cars")
print(fuel_efficient_cars)



ownership_cost_sql = """
SELECT Brand, Model,
       Price + (Service_Cost * 5) AS five_year_cost
FROM cars
ORDER BY five_year_cost ASC
LIMIT 10
"""
ownership_cost = duckdb.query(ownership_cost_sql).to_df()
print("\n Annual ownership cost over 5 years")
print(ownership_cost)



ownership_cost_sql = """
SELECT Brand,
       ROUND(AVG(Service_Cost),0) AS avg_service_cost
FROM cars
GROUP BY Brand
ORDER BY avg_service_cost DESC
"""
ownership_cost = duckdb.query(ownership_cost_sql).to_df()
print("\n Average service cost by brand")
print(ownership_cost)



family_cars_sql = """
SELECT Brand, Model, Seating_Capacity, Mileage
FROM cars
WHERE Seating_Capacity >= 7
ORDER BY Mileage DESC
"""
family_cars = duckdb.query(family_cars_sql).to_df()
print("\n Cars with seating >= 7 and high mileage")
print(family_cars)



premium_cars_sql = """
SELECT Brand, Model, Year, Price
FROM cars
WHERE Year >= 2022 AND Price > 1500000
ORDER BY Price DESC
"""
premium_cars = duckdb.query(premium_cars_sql).to_df()
print("\n Recent models with premium pricing")
print(premium_cars)

query_affordable = """
SELECT Brand,
       Model,
       Price,
       Service_Cost,
       (Price + Service_Cost) AS total_cost
FROM cars
ORDER BY total_cost ASC
LIMIT 10
"""

result_affordable = duckdb.query(query_affordable).to_df()
print("Top 10 most affordable cars (Price + Service Cost)")
print(result_affordable)

affordable_cars_sql = """
SELECT Brand,
       Model,
       Price,
       Service_Cost,
       (Price + Service_Cost) AS total_cost
FROM cars
ORDER BY total_cost ASC
LIMIT 10
"""

affordable_cars = duckdb.query(affordable_cars_sql).to_df()
print("Top 10 most affordable cars (Price + Service Cost)")
print(affordable_cars)
